# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS Origin (e.g. http://localhost:5173 for local, or https://your-app.vercel.app for production)
# Multiple origins can be comma-separated or set to * for development
CLIENT_ORIGIN=http://localhost:5173

# Database path (optional, defaults to database/students.db)
# DB_PATH=./database/students.db
